# Copy to .env and fill in. Neo4j password + KG_API_KEY are the same as the
# fusion stack (.env in fusion_kg_builder).

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=33333
NEO4J_BOLT_PORT=33334

# MongoDB (self-hosted, replaces Atlas — loopback-only, app connects
# internally via smr-kg-net)
MONGO_USER=mongo
MONGO_PASSWORD=<generate: openssl rand -hex 20>
MONGO_PORT=33335
# For dev/seed scripts from a workstation, tunnel the loopback port:
#   ssh -L 33335:localhost:33335 <server>
#   MONGODB_URI=mongodb://mongo:<MONGO_PASSWORD>@localhost:33335/?authSource=admin

# Ollama
OLLAMA_PUBLISHED_PORT=33332
OLLAMA_LLM_MODEL=qwen3.8:27b
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_NUM_CTX=16384

# kg-service
KG_SERVICE_PORT=33336
KG_API_KEY=<long random string>
VECTOR_INDEX_NAME=chunk_embeddings

# App (self-hosted Next.js, container app_smr_tt)
APP_PORT=33337
ADMIN_PASSWORD=<admin UI password>
VOTE_SECRET=<generate: openssl rand -hex 24>

# One-off migration only (scripts/mongo-migrate.sh): Atlas source URI
MONGODB_SOURCE_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net

# Where neo4j/mongo data dirs live (server); override e.g. ./data for local runs
SMR_DATA_DIR=/mnt/data2/smr_tt_data
